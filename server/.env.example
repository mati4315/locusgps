NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=locus_gps
DB_USER=locus_gps
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=3

# SHA-256 hash of the device bearer token; never store the raw token here.
DEVICE_TOKEN_HASH=replace-with-sha256-token-hash
GRAPHHOPPER_API_KEY=replace-with-graphhopper-api-key
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
MAPTILER_API_KEY=replace-with-maptiler-api-key

# Comma-separated origins. Use the Android app's backend origin policy in production.
CORS_ORIGINS=
